{
  "name": "lasercutx",
  "productName": "LaserCutX",
  "version": "1.2.0",
  "description": "Simple desktop designer for metal business cards and custom metal credit cards. Exports laser-ready SVG, DXF and PNG.",
  "main": "electron/main.js",
  "author": "LaserCutX",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.js",
    "test": "node --test tests/*.test.mjs",
    "vendor": "node scripts/copy-vendor.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "opentype.js": "^2.0.0",
    "qrcode-generator": "^2.0.4",
    "@anthropic-ai/sdk": "^0.131.0",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "com.lasercutx.carddesigner",
    "productName": "LaserCutX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "lcx",
        "name": "LaserCutX Project",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-win11-x64.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win11-x64-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png"
    }
  }
}
